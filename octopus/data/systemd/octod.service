# Octopus — servizio octod (spec: docs/spec/SPEC-octod.md, ADR-0008).
# Utente dedicato senza capability: i permessi su systemd vengono solo da
# polkit (50-octopus.rules) e dalla policy D-Bus per freeze/thaw.
[Unit]
Description=Octopus: gestione dei tentacoli
Documentation=https://github.com/Tommaso-Palestini/octopus-linux
After=dbus.service

[Service]
Type=dbus
BusName=io.github.tommaso_palestini.Octopus1
ExecStart=/usr/local/libexec/octod
User=octopus
Group=octopus

# Restrizioni di base (il rafforzamento completo con systemd-analyze è in T7)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
